{
  "name": "BentenganGame",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "SummitShared": {
        "$path": "src/ReplicatedStorage/SummitShared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/ServerScriptService/Server"
      },
      "SummitServer": {
        "$path": "src/ServerScriptService/SummitServer"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Client"
        },
        "SummitClient": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/SummitClient"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.3, 0.3, 0.35],
        "Brightness": 2,
        "ClockTime": 14
      }
    },
    "SoundService": {
      "$className": "SoundService"
    }
  }
}
